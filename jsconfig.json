{
  "compilerOptions": {
    "checkJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "allowJs": true
  },
  "include": [
    "skills/**/*.mjs",
    "skills/**/*.js",
    "test/**/*.mjs",
    "test/**/*.js",
    "tests/**/*.mjs",
    "tests/**/*.js"
  ],
  "exclude": ["node_modules"]
}
